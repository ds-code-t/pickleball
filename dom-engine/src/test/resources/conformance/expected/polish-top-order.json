{
  "case_id": "polish-top-order",
  "group": "polish",
  "path": "/polish/top-order.html",
  "description": "An outside manual popover stays under the modal whether it was shown before or after showModal(). A manual popover inside the dialog, shown after showModal(), paints above the dialog.",
  "capture": {
    "viewport_width": 800,
    "viewport_height": 600,
    "device_scale_factor": 1,
    "page_scale": 1,
    "scroll_x": 0,
    "scroll_y": 0,
    "mobile": false,
    "color_scheme": null,
    "media": null,
    "hit_budget": 1500,
    "hit_cell_css_px": 32,
    "settle": {
      "overall_ms": 2500,
      "network_idle_ms": 150,
      "mutation_quiet_ms": 120,
      "fonts_ms": 1200,
      "images_ms": 1200,
      "animations_ms": 600
    }
  },
  "assertions": [
    {
      "kind": "in_top_layer",
      "id": "dlg",
      "value": true
    },
    {
      "kind": "in_top_layer",
      "id": "early",
      "value": true
    },
    {
      "kind": "in_top_layer",
      "id": "out",
      "value": true
    },
    {
      "kind": "in_top_layer",
      "id": "inn",
      "value": true
    },
    {
      "kind": "top_layer_above",
      "above": "dlg",
      "below": "early"
    },
    {
      "kind": "top_layer_above",
      "above": "dlg",
      "below": "out"
    },
    {
      "kind": "top_layer_above",
      "above": "inn",
      "below": "dlg"
    },
    {
      "kind": "hit",
      "id": "dlg",
      "x": 80,
      "y": 80
    },
    {
      "kind": "hit_not",
      "id": "out",
      "x": 80,
      "y": 80
    },
    {
      "kind": "hit",
      "id": "inn",
      "x": 304,
      "y": 112
    },
    {
      "kind": "hit",
      "id": "dlg",
      "x": 80,
      "y": 304
    },
    {
      "kind": "hit_not",
      "id": "early",
      "x": 80,
      "y": 304
    },
    {
      "kind": "hit",
      "id": "dlg",
      "x": 80,
      "y": 528
    },
    {
      "kind": "hit_not",
      "id": "under",
      "x": 80,
      "y": 528
    },
    {
      "kind": "settled",
      "value": true
    }
  ],
  "queries": [
    {
      "pw": "getByText('dialog-body')",
      "mode": "playwright"
    },
    {
      "pw": "getByText('inside')",
      "mode": "playwright"
    },
    {
      "pw": "getByText('outside')",
      "mode": "playwright"
    },
    {
      "pw": "getByText('early')",
      "mode": "playwright"
    },
    {
      "pw": "getByRole('button', { name: 'Under' })",
      "mode": "playwright"
    },
    {
      "css": "#inn",
      "mode": "playwright",
      "filter": "clickable"
    },
    {
      "css": "#out",
      "mode": "playwright",
      "filter": "clickable"
    },
    {
      "css": "#early",
      "mode": "playwright",
      "filter": "clickable"
    },
    {
      "css": "#under",
      "mode": "playwright",
      "filter": "clickable"
    }
  ]
}
