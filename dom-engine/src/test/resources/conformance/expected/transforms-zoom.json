{
  "case_id": "transforms-zoom",
  "group": "transforms",
  "path": "/transforms/zoom.html",
  "description": "CSS zoom scales the border box. A 160px box at zoom 2 is about 320px wide.",
  "capture": {
    "viewport_width": 800,
    "viewport_height": 600,
    "device_scale_factor": 1,
    "page_scale": 1,
    "scroll_x": 0,
    "scroll_y": 0,
    "mobile": false,
    "color_scheme": null,
    "media": null,
    "hit_budget": 1500,
    "hit_cell_css_px": 32,
    "settle": {
      "overall_ms": 2500,
      "network_idle_ms": 150,
      "mutation_quiet_ms": 120,
      "fonts_ms": 1200,
      "images_ms": 1200,
      "animations_ms": 600
    }
  },
  "assertions": [
    {
      "kind": "style_contains",
      "id": "z",
      "prop": "zoom",
      "text": "2"
    },
    {
      "kind": "quad_width",
      "id": "z",
      "min": 300,
      "max": 340
    }
  ]
}
