{
  "case_id": "scroll-virtual-react",
  "group": "scroll",
  "path": "/scroll/virtual-react.html",
  "description": "Windowed list in the shape of react-window: 8 mounted rows of 1000. Unmounted rows are not invented.",
  "capture": {
    "viewport_width": 800,
    "viewport_height": 600,
    "device_scale_factor": 1,
    "page_scale": 1,
    "scroll_x": 0,
    "scroll_y": 0,
    "mobile": false,
    "color_scheme": null,
    "media": null,
    "hit_budget": 1500,
    "hit_cell_css_px": 32,
    "settle": {
      "overall_ms": 2500,
      "network_idle_ms": 150,
      "mutation_quiet_ms": 120,
      "fonts_ms": 1200,
      "images_ms": 1200,
      "animations_ms": 600
    }
  },
  "assertions": [
    {
      "kind": "count_selector",
      "selector": ".row",
      "min": 8,
      "max": 8
    },
    {
      "kind": "unknown",
      "name": "virtualized_unmounted"
    },
    {
      "kind": "text_contains",
      "id": "list",
      "text": "row-0"
    }
  ]
}
