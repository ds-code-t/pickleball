{
  "case_id": "a11y-hidden-role",
  "group": "a11y",
  "path": "/a11y/hidden-role.html",
  "description": "getByRole skips aria-hidden unless includeHidden is set.",
  "capture": {
    "viewport_width": 800,
    "viewport_height": 600,
    "device_scale_factor": 1,
    "page_scale": 1,
    "scroll_x": 0,
    "scroll_y": 0,
    "mobile": false,
    "color_scheme": null,
    "media": null,
    "hit_budget": 1500,
    "hit_cell_css_px": 32,
    "settle": {
      "overall_ms": 2500,
      "network_idle_ms": 150,
      "mutation_quiet_ms": 120,
      "fonts_ms": 1200,
      "images_ms": 1200,
      "animations_ms": 600
    }
  },
  "assertions": [
    {
      "kind": "element",
      "id": "shown"
    },
    {
      "kind": "element",
      "id": "hid"
    },
    {
      "kind": "query_count",
      "pipeline": "a11y=role=button,name=Hidden",
      "mode": "composite",
      "ids": [],
      "count": 0
    },
    {
      "kind": "query_count",
      "pipeline": "a11y=hidden=true,name=Hidden",
      "mode": "composite",
      "ids": ["hid"],
      "count": 1
    },
    {
      "kind": "query_count",
      "pipeline": "a11y=includehidden=true,role=button",
      "mode": "composite",
      "ids": ["shown", "hid"],
      "count": 2
    },
    {
      "kind": "min_nodes",
      "min": 4
    },
    {
      "kind": "settled",
      "value": true
    },
    {
      "kind": "unknown",
      "name": "http_bodies"
    },
    {
      "kind": "unknown",
      "name": "cookie_values"
    },
    {
      "kind": "unknown",
      "name": "indexed_db_records"
    },
    {
      "kind": "unknown",
      "name": "mutation_timeline"
    },
    {
      "kind": "unknown",
      "name": "user_agent_shadow"
    }
  ],
  "queries": [
    {
      "pw": "getByRole('button', { name: 'Shown' })",
      "mode": "playwright"
    },
    {
      "pw": "getByRole('button', { name: 'Hidden' })",
      "mode": "playwright"
    },
    {
      "pw": "getByRole('button', { name: 'Hidden', includeHidden: true })",
      "mode": "playwright"
    }
  ]
}
