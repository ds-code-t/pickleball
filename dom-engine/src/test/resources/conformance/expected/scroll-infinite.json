{
  "case_id": "scroll-infinite",
  "group": "scroll",
  "path": "/scroll/infinite.html",
  "description": "An infinite-scroll sentinel is recorded. Capture does not keep scrolling.",
  "capture": {
    "viewport_width": 800,
    "viewport_height": 600,
    "device_scale_factor": 1,
    "page_scale": 1,
    "scroll_x": 0,
    "scroll_y": 0,
    "mobile": false,
    "color_scheme": null,
    "media": null,
    "hit_budget": 1500,
    "hit_cell_css_px": 32,
    "settle": {
      "overall_ms": 2500,
      "network_idle_ms": 150,
      "mutation_quiet_ms": 120,
      "fonts_ms": 1200,
      "images_ms": 1200,
      "animations_ms": 600
    }
  },
  "assertions": [
    {
      "kind": "count_selector",
      "selector": ".row",
      "min": 20,
      "max": 20
    },
    {
      "kind": "element",
      "id": "more"
    },
    {
      "kind": "unknown",
      "name": "infinite_scroll_unprobed"
    }
  ]
}
