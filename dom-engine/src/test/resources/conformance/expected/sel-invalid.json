{
  "case_id": "sel-invalid",
  "group": "sel",
  "path": "/sel/invalid.html",
  "description": "Malformed CSS and XPath are errors in both live tools and offline.",
  "capture": {
    "viewport_width": 800,
    "viewport_height": 600,
    "device_scale_factor": 1,
    "page_scale": 1,
    "scroll_x": 0,
    "scroll_y": 0,
    "mobile": false,
    "color_scheme": null,
    "media": null,
    "hit_budget": 1500,
    "hit_cell_css_px": 32,
    "settle": {
      "overall_ms": 2500,
      "network_idle_ms": 150,
      "mutation_quiet_ms": 120,
      "fonts_ms": 1200,
      "images_ms": 1200,
      "animations_ms": 600
    }
  },
  "assertions": [
    {
      "kind": "element",
      "id": "go"
    },
    {
      "kind": "min_nodes",
      "min": 4
    },
    {
      "kind": "settled",
      "value": true
    },
    {
      "kind": "unknown",
      "name": "http_bodies"
    },
    {
      "kind": "unknown",
      "name": "cookie_values"
    },
    {
      "kind": "unknown",
      "name": "indexed_db_records"
    },
    {
      "kind": "unknown",
      "name": "mutation_timeline"
    },
    {
      "kind": "unknown",
      "name": "user_agent_shadow"
    },
    {
      "kind": "query_count",
      "css": "button[",
      "mode": "playwright",
      "expect_error": true
    },
    {
      "kind": "query_count",
      "xpath": "//*[",
      "mode": "selenium",
      "expect_error": true
    }
  ],
  "queries": [
    {
      "css": "button[",
      "mode": "playwright",
      "expect_error": true
    },
    {
      "xpath": "//*[",
      "mode": "playwright",
      "expect_error": true
    },
    {
      "by": "css=button[",
      "mode": "selenium",
      "expect_error": true
    },
    {
      "by": "xpath=//*[",
      "mode": "selenium",
      "expect_error": true
    }
  ]
}
