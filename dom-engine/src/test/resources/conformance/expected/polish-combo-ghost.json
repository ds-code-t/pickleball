{
  "case_id": "polish-combo-ghost",
  "group": "polish",
  "path": "/polish/combo-ghost.html",
  "description": "A role-less div with a random id whose only label is ::before text. A real button owns the word Open. A button whose name is only ::before is found by role, not by text.",
  "capture": {
    "viewport_width": 800,
    "viewport_height": 600,
    "device_scale_factor": 1,
    "page_scale": 1,
    "scroll_x": 0,
    "scroll_y": 0,
    "mobile": false,
    "color_scheme": null,
    "media": null,
    "hit_budget": 4000,
    "hit_cell_css_px": 16,
    "settle": {
      "overall_ms": 2500,
      "network_idle_ms": 150,
      "mutation_quiet_ms": 120,
      "fonts_ms": 1200,
      "images_ms": 1200,
      "animations_ms": 600
    }
  },
  "assertions": [
    {
      "kind": "count_selector",
      "selector": "#seed",
      "max": 0
    },
    {
      "kind": "attr_matches",
      "selector": "[data-stable=open]",
      "name": "id",
      "pattern": "^id-"
    },
    {
      "kind": "pseudo",
      "selector": "[data-stable=open]",
      "pseudo": "before",
      "text_contains": "Open"
    },
    {
      "kind": "pseudo",
      "id": "icon",
      "pseudo": "before",
      "text_contains": "Save"
    },
    {
      "kind": "ax_name_contains",
      "id": "icon",
      "text": "Save"
    },
    {
      "kind": "ax_role_not",
      "selector": "[data-stable=open]",
      "role": "button"
    },
    {
      "kind": "mismatch",
      "selector": "[data-stable=open]",
      "value": "custom"
    },
    {
      "kind": "hit",
      "selector": "[data-stable=open]",
      "x": 88,
      "y": 168
    },
    {
      "kind": "hit_not",
      "id": "real",
      "x": 88,
      "y": 168
    },
    {
      "kind": "focus_order",
      "ids": [
        "real",
        "icon",
        "[data-stable=open]"
      ]
    },
    {
      "kind": "query_count",
      "pw": "getByRole('button', { name: 'Open' })",
      "count": 1
    },
    {
      "kind": "query_count",
      "pw": "getByText('Open')",
      "count": 1
    },
    {
      "kind": "query_count",
      "pw": "getByRole('button', { name: 'Save' })",
      "count": 1
    },
    {
      "kind": "query_count",
      "pw": "getByText('Save')",
      "count": 0
    },
    {
      "kind": "query_count",
      "css": "#seed",
      "mode": "playwright",
      "count": 0
    },
    {
      "kind": "settled",
      "value": true
    }
  ],
  "queries": [
    {
      "pw": "getByRole('button', { name: 'Open' })",
      "mode": "playwright"
    },
    {
      "pw": "getByRole('button', { name: 'Save' })",
      "mode": "playwright"
    },
    {
      "pw": "getByText('Open')",
      "mode": "playwright"
    },
    {
      "pw": "getByText('Save')",
      "mode": "playwright"
    },
    {
      "css": "[data-stable=open]",
      "mode": "playwright"
    },
    {
      "css": "#seed",
      "mode": "playwright"
    },
    {
      "css": "[data-stable=open]",
      "mode": "selenium"
    },
    {
      "css": "#seed",
      "mode": "selenium"
    }
  ]
}
