{
  "case_id": "a11y-at-hidden",
  "group": "a11y",
  "path": "/a11y/at-hidden.html",
  "description": "aria-hidden text stays in the DOM. Chrome omits that span from the accessibility tree; the button name keeps the visible word.",
  "capture": {
    "viewport_width": 800,
    "viewport_height": 600,
    "device_scale_factor": 1,
    "page_scale": 1,
    "scroll_x": 0,
    "scroll_y": 0,
    "mobile": false,
    "color_scheme": null,
    "media": null,
    "hit_budget": 1500,
    "hit_cell_css_px": 32,
    "settle": {
      "overall_ms": 2500,
      "network_idle_ms": 150,
      "mutation_quiet_ms": 120,
      "fonts_ms": 1200,
      "images_ms": 1200,
      "animations_ms": 600
    }
  },
  "assertions": [
    {
      "kind": "text_contains",
      "id": "hide",
      "text": "secret"
    },
    {
      "kind": "ax_name_contains",
      "id": "go",
      "text": "Visible"
    }
  ],
  "queries": [
    {
      "pw": "getByRole('button', { name: 'Visible secret' })",
      "mode": "playwright"
    },
    {
      "pw": "getByText('secret')",
      "mode": "playwright"
    }
  ]
}
