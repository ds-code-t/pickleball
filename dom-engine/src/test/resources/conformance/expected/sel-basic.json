{
  "case_id": "sel-basic",
  "group": "sel",
  "path": "/sel/basic.html",
  "description": "CSS, XPath, and By.id/name/className/tagName on one light tree.",
  "capture": {
    "viewport_width": 800,
    "viewport_height": 600,
    "device_scale_factor": 1,
    "page_scale": 1,
    "scroll_x": 0,
    "scroll_y": 0,
    "mobile": false,
    "color_scheme": null,
    "media": null,
    "hit_budget": 1500,
    "hit_cell_css_px": 32,
    "settle": {
      "overall_ms": 2500,
      "network_idle_ms": 150,
      "mutation_quiet_ms": 120,
      "fonts_ms": 1200,
      "images_ms": 1200,
      "animations_ms": 600
    }
  },
  "assertions": [
    {
      "kind": "element",
      "id": "go"
    },
    {
      "kind": "element",
      "id": "sib"
    },
    {
      "kind": "element",
      "id": "after"
    },
    {
      "kind": "element",
      "id": "q"
    },
    {
      "kind": "element",
      "id": "n1"
    },
    {
      "kind": "element",
      "id": "n2"
    },
    {
      "kind": "element",
      "id": "n3"
    },
    {
      "kind": "element",
      "id": "mark"
    },
    {
      "kind": "min_nodes",
      "min": 4
    },
    {
      "kind": "settled",
      "value": true
    },
    {
      "kind": "unknown",
      "name": "http_bodies"
    },
    {
      "kind": "unknown",
      "name": "cookie_values"
    },
    {
      "kind": "unknown",
      "name": "indexed_db_records"
    },
    {
      "kind": "unknown",
      "name": "mutation_timeline"
    },
    {
      "kind": "unknown",
      "name": "user_agent_shadow"
    }
  ],
  "queries": [
    {
      "css": "#go",
      "mode": "playwright"
    },
    {
      "css": "#go",
      "mode": "selenium"
    },
    {
      "css": "button.a",
      "mode": "playwright"
    },
    {
      "css": "li:nth-child(2)",
      "mode": "playwright"
    },
    {
      "css": "button + button",
      "mode": "playwright"
    },
    {
      "css": "button ~ span",
      "mode": "playwright"
    },
    {
      "css": "[data-k^=x]",
      "mode": "playwright"
    },
    {
      "css": ":is(#go, #after)",
      "mode": "playwright"
    },
    {
      "css": "button:not(.a)",
      "mode": "playwright"
    },
    {
      "css": "div:has(#mark)",
      "mode": "playwright"
    },
    {
      "css": "#box >> #mark",
      "mode": "playwright"
    },
    {
      "by": "id=go",
      "mode": "selenium"
    },
    {
      "by": "name=q",
      "mode": "selenium"
    },
    {
      "by": "className=field",
      "mode": "selenium"
    },
    {
      "by": "tagName=button",
      "mode": "selenium"
    },
    {
      "by": "css=button.a",
      "mode": "selenium"
    },
    {
      "xpath": "//button[@id='go']",
      "mode": "selenium"
    },
    {
      "xpath": "//BUTTON",
      "mode": "selenium"
    },
    {
      "xpath": "//BUTTON",
      "mode": "playwright"
    },
    {
      "xpath": "//li[contains(.,'two')]",
      "mode": "selenium"
    }
  ]
}
