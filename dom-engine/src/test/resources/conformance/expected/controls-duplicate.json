{
  "case_id": "controls-duplicate",
  "group": "controls",
  "path": "/controls/duplicate.html",
  "description": "Two controls with the same visible text stay distinct nodes.",
  "capture": {
    "viewport_width": 800,
    "viewport_height": 600,
    "device_scale_factor": 1,
    "page_scale": 1,
    "scroll_x": 0,
    "scroll_y": 0,
    "mobile": false,
    "color_scheme": null,
    "media": null,
    "hit_budget": 1500,
    "hit_cell_css_px": 32,
    "settle": {
      "overall_ms": 2500,
      "network_idle_ms": 150,
      "mutation_quiet_ms": 120,
      "fonts_ms": 1200,
      "images_ms": 1200,
      "animations_ms": 600
    }
  },
  "assertions": [
    {
      "kind": "count_selector",
      "selector": "button",
      "min": 2,
      "max": 2
    },
    {
      "kind": "text_contains",
      "id": "a",
      "text": "Save"
    },
    {
      "kind": "text_contains",
      "id": "b",
      "text": "Save"
    }
  ],
  "queries": [
    {
      "pw": "getByRole('button', { name: 'Save' })",
      "mode": "playwright",
      "strict": true,
      "expect_error": true
    },
    {
      "by": "tagName=button",
      "mode": "selenium"
    }
  ]
}
