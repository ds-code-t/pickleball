{
  "case_id": "text-pseudo-match",
  "group": "text",
  "path": "/text/pseudo-match.html",
  "description": "Measure whether Playwright text and Selenium linkText include ::before.",
  "capture": {
    "viewport_width": 800,
    "viewport_height": 600,
    "device_scale_factor": 1,
    "page_scale": 1,
    "scroll_x": 0,
    "scroll_y": 0,
    "mobile": false,
    "color_scheme": null,
    "media": null,
    "hit_budget": 1500,
    "hit_cell_css_px": 32,
    "settle": {
      "overall_ms": 2500,
      "network_idle_ms": 150,
      "mutation_quiet_ms": 120,
      "fonts_ms": 1200,
      "images_ms": 1200,
      "animations_ms": 600
    }
  },
  "assertions": [
    {
      "kind": "element",
      "id": "box"
    },
    {
      "kind": "element",
      "id": "link"
    },
    {
      "kind": "min_nodes",
      "min": 4
    },
    {
      "kind": "settled",
      "value": true
    },
    {
      "kind": "unknown",
      "name": "http_bodies"
    },
    {
      "kind": "unknown",
      "name": "cookie_values"
    },
    {
      "kind": "unknown",
      "name": "indexed_db_records"
    },
    {
      "kind": "unknown",
      "name": "mutation_timeline"
    },
    {
      "kind": "unknown",
      "name": "user_agent_shadow"
    },
    {
      "kind": "pseudo",
      "id": "box",
      "pseudo": "before",
      "text_contains": "BEFORE"
    }
  ],
  "queries": [
    {
      "pw": "getByText('core')",
      "mode": "playwright"
    },
    {
      "pw": "getByText('BEFORE')",
      "mode": "playwright"
    },
    {
      "by": "linkText=PRE core",
      "mode": "selenium"
    }
  ]
}
