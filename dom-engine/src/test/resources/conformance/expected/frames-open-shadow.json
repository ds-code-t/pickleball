{
  "case_id": "frames-open-shadow",
  "group": "frames",
  "path": "/frames/open-shadow.html",
  "description": "Open shadow root pierced by CDP. elementFromPoint returns the inner button.",
  "capture": {
    "viewport_width": 800,
    "viewport_height": 600,
    "device_scale_factor": 1,
    "page_scale": 1,
    "scroll_x": 0,
    "scroll_y": 0,
    "mobile": false,
    "color_scheme": null,
    "media": null,
    "hit_budget": 1500,
    "hit_cell_css_px": 32,
    "settle": {
      "overall_ms": 2500,
      "network_idle_ms": 150,
      "mutation_quiet_ms": 120,
      "fonts_ms": 1200,
      "images_ms": 1200,
      "animations_ms": 600
    }
  },
  "assertions": [
    {
      "kind": "shadow",
      "id": "host",
      "root": "open",
      "child_id": "in"
    },
    {
      "kind": "hit",
      "id": "in",
      "x": 224,
      "y": 144
    }
  ],
  "queries": [
    {
      "css": "#in",
      "mode": "playwright"
    },
    {
      "css": "#in",
      "mode": "selenium"
    },
    {
      "by": "css=#host >> shadow >> css=#in",
      "mode": "selenium"
    }
  ]
}
