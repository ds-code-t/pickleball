{
  "case_id": "polish-frame-shadow-frame",
  "group": "polish",
  "path": "/polish/frame-shadow-frame.html",
  "description": "An iframe inside an open shadow root inside an iframe. The leaf button is frame path 0/0/0.",
  "capture": {
    "viewport_width": 800,
    "viewport_height": 600,
    "device_scale_factor": 1,
    "page_scale": 1,
    "scroll_x": 0,
    "scroll_y": 0,
    "mobile": false,
    "color_scheme": null,
    "media": null,
    "hit_budget": 1500,
    "hit_cell_css_px": 32,
    "settle": {
      "overall_ms": 2500,
      "network_idle_ms": 150,
      "mutation_quiet_ms": 120,
      "fonts_ms": 1200,
      "images_ms": 1200,
      "animations_ms": 600
    }
  },
  "assertions": [
    {
      "kind": "shadow",
      "id": "host",
      "root": "open"
    },
    {
      "kind": "frame_text",
      "frame_path": "0/0/0",
      "text": "LeafGo"
    },
    {
      "kind": "element",
      "id": "go"
    },
    {
      "kind": "settled",
      "value": true
    }
  ],
  "queries": [
    {
      "pw": "frameLocator('#outer').frameLocator('#inner').locator('#go')",
      "mode": "playwright"
    },
    {
      "css": "#go",
      "mode": "selenium"
    }
  ]
}
