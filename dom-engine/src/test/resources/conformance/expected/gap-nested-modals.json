    {
      "kind": "focus_absent",
      "id": "abtn"
    },
    {
      "kind": "focus_absent",
      "id": "outside"
    },
    {
      "kind": "query_count",
      "pw": "getByRole('button', { name: 'B-btn' })",
      "count": 1
    },
    {
      "kind": "query_count",
      "pw": "getByRole('button', { name: 'A-btn' })",
      "count": 1
    },
    {
      "kind": "query_count",
      "pw": "getByRole('button', { name: 'Outside' })",
