{
  "case_id": "frames-sandbox",
  "group": "frames",
  "path": "/frames/sandbox.html",
  "description": "Sandboxed iframe that stays same-origin so its document is readable.",
  "capture": {
    "viewport_width": 800,
    "viewport_height": 600,
    "device_scale_factor": 1,
    "page_scale": 1,
    "scroll_x": 0,
    "scroll_y": 0,
    "mobile": false,
    "color_scheme": null,
    "media": null,
    "hit_budget": 1500,
    "hit_cell_css_px": 32,
    "settle": {
      "overall_ms": 2500,
      "network_idle_ms": 150,
      "mutation_quiet_ms": 120,
      "fonts_ms": 1200,
      "images_ms": 1200,
      "animations_ms": 600
    }
  },
  "assertions": [
    {
      "kind": "attr",
      "id": "f",
      "name": "sandbox",
      "value": "allow-same-origin"
    },
    {
      "kind": "frame_text",
      "frame_path": "0/0",
      "text": "same-origin-child"
    }
  ]
}
