{
  "case_id": "hiding-aria-hidden",
  "group": "hiding",
  "path": "/hiding/aria-hidden.html",
  "description": "aria-hidden keeps the box and the hit target, and marks the AX node ignored.",
  "capture": {
    "viewport_width": 800,
    "viewport_height": 600,
    "device_scale_factor": 1,
    "page_scale": 1,
    "scroll_x": 0,
    "scroll_y": 0,
    "mobile": false,
    "color_scheme": null,
    "media": null,
    "hit_budget": 1500,
    "hit_cell_css_px": 32,
    "settle": {
      "overall_ms": 2500,
      "network_idle_ms": 150,
      "mutation_quiet_ms": 120,
      "fonts_ms": 1200,
      "images_ms": 1200,
      "animations_ms": 600
    }
  },
  "assertions": [
    {
      "kind": "attr",
      "id": "go",
      "name": "aria-hidden",
      "value": "true"
    },
    {
      "kind": "ax_ignored",
      "id": "go",
      "value": true
    },
    {
      "kind": "hit",
      "id": "go",
      "x": 224,
      "y": 144
    },
    {
      "kind": "mismatch",
      "id": "go",
      "value": "at-hidden"
    }
  ],
  "queries": [
    {
      "css": "#go",
      "mode": "playwright",
      "filter": "visible"
    },
    {
      "pw": "getByRole('button', { name: 'Go' })",
      "mode": "playwright"
    },
    {
      "pw": "getByRole('button', { name: 'Go', includeHidden: true })",
      "mode": "playwright"
    },
    {
      "css": "#go",
      "mode": "selenium",
      "filter": "displayed"
    }
  ]
}
