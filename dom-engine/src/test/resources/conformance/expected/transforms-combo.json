{
  "case_id": "transforms-combo",
  "group": "transforms",
  "path": "/transforms/combo.html",
  "description": "Zoom, device pixel ratio, a rotation, and a sticky header on one page.",
  "capture": {
    "viewport_width": 400,
    "viewport_height": 300,
    "device_scale_factor": 2,
    "page_scale": 1,
    "scroll_x": 0,
    "scroll_y": 0,
    "mobile": false,
    "color_scheme": null,
    "media": null,
    "hit_budget": 1500,
    "hit_cell_css_px": 32,
    "settle": {
      "overall_ms": 2500,
      "network_idle_ms": 150,
      "mutation_quiet_ms": 120,
      "fonts_ms": 1200,
      "images_ms": 1200,
      "animations_ms": 600
    }
  },
  "assertions": [
    {
      "kind": "screenshot_dpr",
      "shot": "viewport"
    },
    {
      "kind": "style_contains",
      "id": "z",
      "prop": "zoom",
      "text": "2"
    },
    {
      "kind": "rotated",
      "id": "spin"
    },
    {
      "kind": "style",
      "id": "head",
      "prop": "position",
      "value": "sticky"
    },
    {
      "kind": "hit",
      "id": "head",
      "x": 140,
      "y": 368
    },
    {
      "kind": "hit_not",
      "id": "spin",
      "x": 140,
      "y": 368
    }
  ]
}
