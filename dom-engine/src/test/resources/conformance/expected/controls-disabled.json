{
  "case_id": "controls-disabled",
  "group": "controls",
  "path": "/controls/disabled.html",
  "description": "disabled, aria-disabled, readonly, inert, and a disabled fieldset.",
  "capture": {
    "viewport_width": 800,
    "viewport_height": 600,
    "device_scale_factor": 1,
    "page_scale": 1,
    "scroll_x": 0,
    "scroll_y": 0,
    "mobile": false,
    "color_scheme": null,
    "media": null,
    "hit_budget": 1500,
    "hit_cell_css_px": 32,
    "settle": {
      "overall_ms": 2500,
      "network_idle_ms": 150,
      "mutation_quiet_ms": 120,
      "fonts_ms": 1200,
      "images_ms": 1200,
      "animations_ms": 600
    }
  },
  "assertions": [
    {
      "kind": "element",
      "id": "dis"
    },
    {
      "kind": "element",
      "id": "aria"
    },
    {
      "kind": "element",
      "id": "ro"
    },
    {
      "kind": "element",
      "id": "inb"
    },
    {
      "kind": "element",
      "id": "fs"
    },
    {
      "kind": "element",
      "id": "ok"
    },
    {
      "kind": "query_count",
      "pipeline": "a11y=role=button,name=No,disabled",
      "mode": "composite",
      "ids": ["dis"],
      "count": 1
    },
    {
      "kind": "query_count",
      "pipeline": "a11y=role=button,name=Aria,disabled",
      "mode": "composite",
      "ids": ["aria"],
      "count": 1
    },
    {
      "kind": "query_count",
      "pipeline": "a11y=disabled=false,name=Ok",
      "mode": "composite",
      "ids": ["ok"],
      "count": 1
    },
    {
      "kind": "query_count",
      "pipeline": "a11y=value=ro",
      "mode": "composite",
      "ids": ["ro"],
      "count": 1
    },
    {
      "kind": "min_nodes",
      "min": 4
    },
    {
      "kind": "settled",
      "value": true
    },
    {
      "kind": "unknown",
      "name": "http_bodies"
    },
    {
      "kind": "unknown",
      "name": "cookie_values"
    },
    {
      "kind": "unknown",
      "name": "indexed_db_records"
    },
    {
      "kind": "unknown",
      "name": "mutation_timeline"
    },
    {
      "kind": "unknown",
      "name": "user_agent_shadow"
    }
  ],
  "queries": [
    {
      "pw": "getByRole('button', { name: 'Ok' })",
      "mode": "playwright"
    },
    {
      "pw": "getByRole('button', { name: 'No', disabled: true })",
      "mode": "playwright"
    },
    {
      "by": "tagName=button",
      "mode": "selenium",
      "filter": "se-enabled"
    },
    {
      "css": "#ok",
      "mode": "playwright",
      "filter": "clickable"
    },
    {
      "css": "#dis",
      "mode": "playwright",
      "filter": "clickable"
    },
    {
      "css": "#fs",
      "mode": "playwright",
      "filter": "clickable"
    },
    {
      "css": "#ro",
      "mode": "selenium",
      "filter": "se-enabled"
    }
  ]
}
