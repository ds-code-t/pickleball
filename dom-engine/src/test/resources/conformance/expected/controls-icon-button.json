{
  "case_id": "controls-icon-button",
  "group": "controls",
  "path": "/controls/icon-button.html",
  "description": "Icon-only button. The accessible name comes from aria-label.",
  "capture": {
    "viewport_width": 800,
    "viewport_height": 600,
    "device_scale_factor": 1,
    "page_scale": 1,
    "scroll_x": 0,
    "scroll_y": 0,
    "mobile": false,
    "color_scheme": null,
    "media": null,
    "hit_budget": 1500,
    "hit_cell_css_px": 32,
    "settle": {
      "overall_ms": 2500,
      "network_idle_ms": 150,
      "mutation_quiet_ms": 120,
      "fonts_ms": 1200,
      "images_ms": 1200,
      "animations_ms": 600
    }
  },
  "assertions": [
    {
      "kind": "ax_role",
      "id": "find",
      "role": "button"
    },
    {
      "kind": "ax_name_contains",
      "id": "find",
      "text": "search"
    }
  ],
  "queries": [
    {
      "pw": "getByRole('button', { name: 'search' })",
      "mode": "playwright"
    }
  ]
}
