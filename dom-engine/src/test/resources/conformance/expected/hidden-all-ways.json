{
  "case_id": "hidden-all-ways",
  "group": "hidden",
  "path": "/hidden/all-ways.html",
  "description": "display, visibility, opacity, zero, offscreen, clip, inert, aria-hidden, content-visibility.",
  "capture": {
    "viewport_width": 800,
    "viewport_height": 600,
    "device_scale_factor": 1,
    "page_scale": 1,
    "scroll_x": 0,
    "scroll_y": 0,
    "mobile": false,
    "color_scheme": null,
    "media": null,
    "hit_budget": 1500,
    "hit_cell_css_px": 32,
    "settle": {
      "overall_ms": 2500,
      "network_idle_ms": 150,
      "mutation_quiet_ms": 120,
      "fonts_ms": 1200,
      "images_ms": 1200,
      "animations_ms": 600
    }
  },
  "assertions": [
    {
      "kind": "element",
      "id": "show"
    },
    {
      "kind": "element",
      "id": "disp"
    },
    {
      "kind": "element",
      "id": "vis"
    },
    {
      "kind": "element",
      "id": "op"
    },
    {
      "kind": "element",
      "id": "zero"
    },
    {
      "kind": "element",
      "id": "off"
    },
    {
      "kind": "element",
      "id": "clip"
    },
    {
      "kind": "element",
      "id": "inb"
    },
    {
      "kind": "element",
      "id": "aria"
    },
    {
      "kind": "element",
      "id": "cv"
    },
    {
      "kind": "min_nodes",
      "min": 4
    },
    {
      "kind": "settled",
      "value": true
    },
    {
      "kind": "unknown",
      "name": "http_bodies"
    },
    {
      "kind": "unknown",
      "name": "cookie_values"
    },
    {
      "kind": "unknown",
      "name": "indexed_db_records"
    },
    {
      "kind": "unknown",
      "name": "mutation_timeline"
    },
    {
      "kind": "unknown",
      "name": "user_agent_shadow"
    }
  ],
  "queries": [
    {
      "css": "button",
      "mode": "playwright",
      "filter": "visible"
    },
    {
      "css": "button",
      "mode": "selenium",
      "filter": "displayed"
    },
    {
      "css": "#off",
      "mode": "playwright",
      "filter": "in-viewport"
    },
    {
      "css": "#off",
      "mode": "selenium",
      "filter": "displayed"
    },
    {
      "css": "#off",
      "mode": "selenium",
      "filter": "in-viewport"
    },
    {
      "css": "#show",
      "mode": "playwright",
      "filter": "clickable"
    },
    {
      "css": "#inb",
      "mode": "playwright",
      "filter": "clickable"
    },
    {
      "css": "#inb",
      "mode": "selenium",
      "filter": "se-enabled"
    },
    {
      "css": "#op",
      "mode": "playwright",
      "filter": "visible"
    },
    {
      "css": "#op",
      "mode": "selenium",
      "filter": "displayed"
    }
  ]
}
