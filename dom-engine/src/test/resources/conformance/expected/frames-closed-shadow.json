{
  "case_id": "frames-closed-shadow",
  "group": "frames",
  "path": "/frames/closed-shadow.html",
  "description": "Closed shadow is visible to CDP and invisible to the hit probe, which stops at the host.",
  "capture": {
    "viewport_width": 800,
    "viewport_height": 600,
    "device_scale_factor": 1,
    "page_scale": 1,
    "scroll_x": 0,
    "scroll_y": 0,
    "mobile": false,
    "color_scheme": null,
    "media": null,
    "hit_budget": 1500,
    "hit_cell_css_px": 32,
    "settle": {
      "overall_ms": 2500,
      "network_idle_ms": 150,
      "mutation_quiet_ms": 120,
      "fonts_ms": 1200,
      "images_ms": 1200,
      "animations_ms": 600
    }
  },
  "assertions": [
    {
      "kind": "shadow",
      "id": "host",
      "root": "closed",
      "child_id": "secret"
    },
    {
      "kind": "text_contains",
      "id": "secret",
      "text": "secret"
    },
    {
      "kind": "hit",
      "id": "host",
      "x": 224,
      "y": 144
    },
    {
      "kind": "hit_not",
      "id": "secret",
      "x": 224,
      "y": 144
    },
    {
      "kind": "unknown",
      "name": "closed_shadow_hit"
    },
    {
      "kind": "query_count",
      "css": "#secret",
      "mode": "composite",
      "min": 1
    }
  ],
  "queries": [
    {
      "css": "#secret",
      "mode": "playwright"
    },
    {
      "css": "#secret",
      "mode": "selenium"
    }
  ]
}
