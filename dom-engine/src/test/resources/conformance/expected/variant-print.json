{
  "case_id": "variant-print",
  "group": "variant",
  "path": "/variant/print.html",
  "description": "Emulated print media swaps which paragraph is display:block.",
  "capture": {
    "viewport_width": 800,
    "viewport_height": 600,
    "device_scale_factor": 1,
    "page_scale": 1,
    "scroll_x": 0,
    "scroll_y": 0,
    "mobile": false,
    "color_scheme": null,
    "media": "print",
    "hit_budget": 1500,
    "hit_cell_css_px": 32,
    "settle": {
      "overall_ms": 2500,
      "network_idle_ms": 150,
      "mutation_quiet_ms": 120,
      "fonts_ms": 1200,
      "images_ms": 1200,
      "animations_ms": 600
    }
  },
  "assertions": [
    {
      "kind": "style",
      "id": "print-only",
      "prop": "display",
      "value": "block"
    },
    {
      "kind": "style",
      "id": "screen-only",
      "prop": "display",
      "value": "none"
    },
    {
      "kind": "text_contains",
      "id": "print-only",
      "text": "print-me"
    }
  ]
}
