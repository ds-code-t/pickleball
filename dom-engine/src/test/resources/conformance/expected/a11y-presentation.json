{
  "case_id": "a11y-presentation",
  "group": "a11y",
  "path": "/a11y/presentation.html",
  "description": "role=presentation is in the DOM. The node is not exposed as an image.",
  "capture": {
    "viewport_width": 800,
    "viewport_height": 600,
    "device_scale_factor": 1,
    "page_scale": 1,
    "scroll_x": 0,
    "scroll_y": 0,
    "mobile": false,
    "color_scheme": null,
    "media": null,
    "hit_budget": 1500,
    "hit_cell_css_px": 32,
    "settle": {
      "overall_ms": 2500,
      "network_idle_ms": 150,
      "mutation_quiet_ms": 120,
      "fonts_ms": 1200,
      "images_ms": 1200,
      "animations_ms": 600
    }
  },
  "assertions": [
    {
      "kind": "attr",
      "id": "pic",
      "name": "role",
      "value": "presentation"
    },
    {
      "kind": "ax_role_not",
      "id": "pic",
      "role": "image"
    },
    {
      "kind": "mismatch",
      "id": "pic",
      "value": "at-hidden"
    }
  ],
  "queries": [
    {
      "pw": "getByRole('img', { name: 'decor' })",
      "mode": "playwright"
    }
  ]
}
