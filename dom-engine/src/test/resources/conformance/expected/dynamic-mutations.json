{
  "case_id": "dynamic-mutations",
  "group": "dynamic",
  "path": "/dynamic/mutations.html",
  "description": "Mutations every 10ms never go quiet. high_frequency is set when the count passes 20.",
  "capture": {
    "viewport_width": 800,
    "viewport_height": 600,
    "device_scale_factor": 1,
    "page_scale": 1,
    "scroll_x": 0,
    "scroll_y": 0,
    "mobile": false,
    "color_scheme": null,
    "media": null,
    "hit_budget": 1500,
    "hit_cell_css_px": 32,
    "settle": {
      "overall_ms": 900,
      "network_idle_ms": 150,
      "mutation_quiet_ms": 200,
      "fonts_ms": 1200,
      "images_ms": 1200,
      "animations_ms": 600
    }
  },
  "assertions": [
    {
      "kind": "element",
      "id": "tick"
    },
    {
      "kind": "settled",
      "value": false
    },
    {
      "kind": "high_frequency",
      "value": true
    },
    {
      "kind": "pending_contains",
      "text": "mutations"
    }
  ]
}
